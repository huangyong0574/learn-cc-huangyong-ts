# 复制成 .env 后填写。.env 已在 .gitignore 里。
#
# 本仓库只用 DeepSeek，端点写死在 src/shared/client.ts。
# 唯一必填的就是下面这个 key：https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=sk-xxx

# 选填：不填就是 deepseek-v4-flash。可选值以 DeepSeek 平台文档为准。
# MODEL_ID=deepseek-v4-flash   # 默认。便宜快，跑循环调试 harness 用这个
# MODEL_ID=deepseek-v4-pro     # 要看模型能力时再换

# 注意：ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN 在这里【全部无效】。
# shell 里就算有（Claude Code 会注入），也不会影响本仓库 —— client.ts 已显式把它们挡掉。
