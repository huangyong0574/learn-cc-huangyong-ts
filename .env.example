# 复制成 .env 后填写。.env 已在 .gitignore 里。
# 与 ../learn-claude-code/.env.example 保持同一套变量名，两个仓库可以共用一份配置。

# 必填
ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_ID=claude-sonnet-4-6

# 选填：走 Anthropic 兼容的第三方端点时才需要
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 常见兼容 provider（完整清单见 ../learn-claude-code/.env.example）
# GLM (Zhipu)      ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic   MODEL_ID=glm-5.2
# Kimi (Moonshot)  ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic        MODEL_ID=kimi-k2.7-code
# DeepSeek         ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic       MODEL_ID=deepseek-v4-pro
